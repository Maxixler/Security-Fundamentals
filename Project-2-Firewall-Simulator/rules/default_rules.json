{
    "default_policy": "DENY",
    "rules": [
        {
            "rule_id": 2,
            "name": "Allow DNS",
            "priority": 100,
            "action": "ALLOW",
            "protocol": "UDP",
            "src_ip": "192.168.1.0/24",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 53,
            "direction": "OUTBOUND",
            "description": "Allow DNS queries from internal network",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 3,
            "name": "Allow HTTPS Out",
            "priority": 110,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "192.168.1.0/24",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 443,
            "direction": "OUTBOUND",
            "description": "Allow HTTPS traffic from internal to internet",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 4,
            "name": "Allow HTTP Out",
            "priority": 120,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "192.168.1.0/24",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 80,
            "direction": "OUTBOUND",
            "description": "Allow HTTP traffic from internal to internet",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 5,
            "name": "Allow SSH Admin",
            "priority": 130,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "10.0.0.0/24",
            "dst_ip": "192.168.1.0/24",
            "src_port": 0,
            "dst_port": 22,
            "direction": "ANY",
            "description": "Allow SSH from management VLAN to trusted network only",
            "enabled": true,
            "log": true
        },
        {
            "rule_id": 6,
            "name": "Allow Web to DMZ",
            "priority": 140,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "any",
            "dst_ip": "172.16.0.0/24",
            "src_port": 0,
            "dst_port": 443,
            "direction": "INBOUND",
            "description": "Allow HTTPS to DMZ web servers from anywhere",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 7,
            "name": "Allow SMTP to DMZ",
            "priority": 150,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "192.168.1.0/24",
            "dst_ip": "172.16.0.0/24",
            "src_port": 0,
            "dst_port": 25,
            "direction": "OUTBOUND",
            "description": "Allow SMTP from internal to DMZ mail server",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 8,
            "name": "Block Telnet",
            "priority": 50,
            "action": "DENY",
            "protocol": "TCP",
            "src_ip": "any",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 23,
            "direction": "ANY",
            "description": "Block all Telnet - insecure unencrypted protocol",
            "enabled": true,
            "log": true
        },
        {
            "rule_id": 9,
            "name": "Block IT to OT Modbus",
            "priority": 40,
            "action": "DENY",
            "protocol": "TCP",
            "src_ip": "192.168.1.0/24",
            "dst_ip": "10.10.0.0/16",
            "src_port": 0,
            "dst_port": 502,
            "direction": "ANY",
            "description": "CRITICAL: Block Modbus from IT to OT network",
            "enabled": true,
            "log": true
        },
        {
            "rule_id": 10,
            "name": "Block OT to Internet",
            "priority": 30,
            "action": "DENY",
            "protocol": "ANY",
            "src_ip": "10.10.0.0/16",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 0,
            "direction": "OUTBOUND",
            "zone_src": "ot_network",
            "zone_dst": "untrusted",
            "description": "CRITICAL: OT devices must NEVER access internet directly",
            "enabled": true,
            "log": true
        },
        {
            "rule_id": 11,
            "name": "Allow OT Modbus Internal",
            "priority": 160,
            "action": "ALLOW",
            "protocol": "TCP",
            "src_ip": "10.10.0.0/16",
            "dst_ip": "10.10.0.0/16",
            "src_port": 0,
            "dst_port": 502,
            "direction": "ANY",
            "description": "Allow Modbus within OT network (PLC to HMI)",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 12,
            "name": "Allow NTP",
            "priority": 170,
            "action": "ALLOW",
            "protocol": "UDP",
            "src_ip": "any",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 123,
            "direction": "ANY",
            "description": "Allow NTP time synchronization",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 13,
            "name": "Allow Syslog to SIEM",
            "priority": 180,
            "action": "ALLOW",
            "protocol": "UDP",
            "src_ip": "any",
            "dst_ip": "10.0.0.0/24",
            "src_port": 0,
            "dst_port": 514,
            "direction": "ANY",
            "description": "Allow syslog to management SIEM server",
            "enabled": true,
            "log": false
        },
        {
            "rule_id": 14,
            "name": "Log and Deny All",
            "priority": 9999,
            "action": "DENY",
            "protocol": "ANY",
            "src_ip": "any",
            "dst_ip": "any",
            "src_port": 0,
            "dst_port": 0,
            "direction": "ANY",
            "description": "Default deny with logging - catch all unmatched traffic",
            "enabled": true,
            "log": true
        }
    ]
}
